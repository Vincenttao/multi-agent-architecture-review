{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vincenttao/multi-agent-architecture-review/schemas/assessment-output.schema.json",
  "title": "Multi-Agent Architecture Assessment",
  "type": "object",
  "required": [
    "summary",
    "scope",
    "entities",
    "interaction_edges",
    "findings",
    "hard_failures",
    "simplification_opportunities",
    "remediation_plan",
    "limitations"
  ],
  "properties": {
    "summary": {
      "type": "object",
      "required": ["overall_score", "risk_level", "primary_pattern", "conclusion"],
      "properties": {
        "overall_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "risk_level": {"enum": ["low", "medium", "high", "critical"]},
        "primary_pattern": {"enum": ["single_agent", "calling", "delegation", "coordination", "mixed", "unknown"]},
        "secondary_patterns": {
          "type": "array",
          "items": {"enum": ["calling", "delegation", "coordination"]},
          "uniqueItems": true
        },
        "conclusion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["reviewed_paths", "languages"],
      "properties": {
        "repository": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "reviewed_paths": {"type": "array", "items": {"type": "string"}},
        "excluded_paths": {"type": "array", "items": {"type": "string"}},
        "languages": {"type": "array", "items": {"type": "string"}},
        "frameworks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entity_type", "symbol", "file"],
        "properties": {
          "id": {"type": "string"},
          "entity_type": {"enum": ["agent", "tool", "controller", "router", "task_manager", "state_store", "transport", "validator", "human_gate", "other"]},
          "symbol": {"type": "string"},
          "file": {"type": "string"},
          "line_start": {"type": ["integer", "null"], "minimum": 1},
          "line_end": {"type": ["integer", "null"], "minimum": 1},
          "model": {"type": ["string", "null"]},
          "tools": {"type": "array", "items": {"type": "string"}},
          "permissions": {"type": "array", "items": {"type": "string"}},
          "state_owner": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "interaction_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "classification", "classification_confidence", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "classification": {"enum": ["calling", "delegation", "coordination", "not_agent_interaction", "unknown"]},
          "classification_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "trigger": {"type": ["string", "null"]},
          "payload_type": {"type": ["string", "null"]},
          "response_type": {"type": ["string", "null"]},
          "execution_mode": {"enum": ["sync", "async", "event_driven", "streaming", "unknown"]},
          "control_owner": {"type": ["string", "null"]},
          "shared_state": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "hard_failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "design_smells": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "simplification_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "current_design", "recommended_design", "reason", "evidence"],
        "properties": {
          "target": {"type": "string"},
          "current_design": {"type": "string"},
          "recommended_design": {"enum": ["function", "tool", "service", "workflow_node", "calling", "delegation", "coordination", "retain_current"]},
          "reason": {"type": "string"},
          "expected_benefit": {"type": "string"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        },
        "additionalProperties": false
      }
    },
    "remediation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "action", "addresses_rules"],
        "properties": {
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "action": {"type": "string"},
          "addresses_rules": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unknown", "impact"],
        "properties": {
          "unknown": {"type": "string"},
          "impact": {"type": "string"},
          "needed_evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["file", "symbol", "confidence", "summary"],
      "properties": {
        "file": {"type": "string"},
        "symbol": {"type": "string"},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "confidence": {"enum": ["direct", "strong_inference", "weak_inference", "unknown"]},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["rule_id", "severity", "title", "conclusion", "why_it_matters", "evidence", "recommendation"],
      "properties": {
        "rule_id": {"type": "string"},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "title": {"type": "string"},
        "conclusion": {"type": "string"},
        "why_it_matters": {"type": "string"},
        "affected_entities": {"type": "array", "items": {"type": "string"}},
        "affected_edges": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "recommendation": {"type": "string"},
        "score_impact": {"type": ["integer", "null"], "maximum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
